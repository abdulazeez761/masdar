@model Masdar.Web.ViewModels.TutorPageViewModel
@{
    ViewData["Title"] = "Masdar AI tutor";
    var course = Model.Workspace.ActiveCourse;
    var primaryTopic = Model.Workspace.Topics.FirstOrDefault() ?? course?.Name ?? "this course";
}

<header class="tutor-page-head">
    <div class="tutor-title-lockup">
        <span class="tutor-title-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="m12 3 1.35 4.15L17.5 8.5l-4.15 1.35L12 14l-1.35-4.15L6.5 8.5l4.15-1.35L12 3Z"/><path d="m19 14 .85 2.15L22 17l-2.15.85L19 20l-.85-2.15L16 17l2.15-.85L19 14Z"/></svg>
        </span>
        <div>
            <div class="eyebrow">Grounded study help</div>
            <h1 data-i18n="masdarTutor">Masdar AI tutor</h1>
            <p>Explanations, examples, quizzes, and study plans grounded in your active course resources.</p>
        </div>
    </div>
    @if (course is not null)
    {
        <a class="btn btn-soft tutor-course-link" asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id">
            Open course workspace
        </a>
    }
</header>

@if (course is null)
{
    <section class="tutor-empty card" aria-labelledby="no-course-title">
        <span class="tutor-empty-icon" aria-hidden="true">✦</span>
        <h2 id="no-course-title">Choose an active course first</h2>
        <p>The tutor never asks you to pick a subject. It automatically follows the course you mark active, which keeps every answer and citation inside the right course.</p>
        <a class="btn btn-primary" asp-controller="Courses" asp-action="Index">Choose from Courses</a>
    </section>
}
else
{
    <section class="tutor-context-bar" aria-label="Your active course">
        <div class="tutor-context-dot" aria-hidden="true"></div>
        <div class="tutor-context-copy">
            <span>Your active course</span>
            <strong>@course.Code · @course.Name</strong>
            <small>@course.Instructor · @course.Semester · @course.PublishedResourceCount trusted sources</small>
        </div>
        <a asp-controller="Courses" asp-action="Index">Change active course</a>
    </section>

    @if (Model.ContextChanged)
    {
        <div class="alert alert-info tutor-context-reset" role="status">
            <strong>Course context reset.</strong> Your active course changed while this page was open. The previous question was cleared so it cannot be answered from the wrong subject.
        </div>
    }

    <div class="tutor-layout">
        <section class="tutor-chat card" aria-label="Course tutor conversation">
            <div class="tutor-chat-head">
                <div>
                    <span class="tutor-online-dot" aria-hidden="true"></span>
                    <strong>Masdar AI tutor</strong>
                    <small>Grounded in @course.Code only</small>
                </div>
                <span class="tutor-source-count">@course.PublishedResourceCount sources available</span>
            </div>

            <div class="tutor-messages" aria-live="polite">
                @if (Model.Exchange is null)
                {
                    <article class="tutor-message tutor-message-assistant">
                        <span class="tutor-avatar" aria-hidden="true">✦</span>
                        <div class="tutor-bubble">
                            <strong>Ready for @course.Name</strong>
                            <p>I’ll retrieve only published, validated @course.Code materials, explain the idea step by step, and show every source I use. Try a prompt below or ask your own question.</p>
                        </div>
                    </article>
                }
                else
                {
                    <article class="tutor-message tutor-message-user">
                        <div class="tutor-bubble" dir="auto">@Model.Exchange.Question</div>
                        <span class="tutor-avatar tutor-avatar-user" aria-hidden="true">You</span>
                    </article>

                    <article class="tutor-message tutor-message-assistant @(Model.Exchange.IsOutOfScope ? "tutor-message-redirect" : "")">
                        <span class="tutor-avatar" aria-hidden="true">✦</span>
                        <div class="tutor-bubble tutor-answer" dir="auto">
                            @if (Model.Exchange.IsOutOfScope)
                            {
                                <span class="tutor-scope-badge">Outside active course</span>
                            }
                            <p class="tutor-answer-lead">@Model.Exchange.Lead</p>
                            @foreach (var answerSection in Model.Exchange.Sections)
                            {
                                <section class="tutor-answer-section">
                                    <h2>@answerSection.Heading</h2>
                                    <p>@answerSection.Content</p>
                                </section>
                            }

                            @if (Model.Exchange.Citations.Count > 0)
                            {
                                <section class="tutor-citations" aria-labelledby="tutor-sources-title">
                                    <h2 id="tutor-sources-title">Sources used</h2>
                                    <div class="tutor-source-list">
                                        @foreach (var citation in Model.Exchange.Citations)
                                        {
                                            <a class="tutor-source" asp-controller="Resources" asp-action="Details" asp-route-id="@citation.ResourceId">
                                                <span class="tutor-source-number">@citation.Number</span>
                                                <span>
                                                    <strong>@citation.Title</strong>
                                                    <small>@citation.ResourceType · @citation.MatchReason</small>
                                                    <span>@citation.Excerpt</span>
                                                </span>
                                                <span class="tutor-source-arrow" aria-hidden="true">→</span>
                                            </a>
                                        }
                                    </div>
                                </section>
                            }
                            else if (!Model.Exchange.IsOutOfScope)
                            {
                                <div class="alert alert-warning mb-0">No eligible source was available, so the tutor did not invent a citation.</div>
                            }
                        </div>
                    </article>
                }
            </div>

            <form asp-action="Index" method="post" class="tutor-composer" id="tutor-form">
                @Html.AntiForgeryToken()
                <input asp-for="ContextCourseId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <label asp-for="Question">Ask about this course</label>
                <div class="tutor-input-wrap">
                    <textarea asp-for="Question" rows="3" maxlength="800" dir="auto" placeholder="Ask about this course" aria-describedby="tutor-input-help tutor-question-count"></textarea>
                    <button class="btn btn-primary tutor-send" type="submit">
                        <span>Send</span>
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m4 4 17 8-17 8 3-8-3-8Z"/><path d="M7 12h14"/></svg>
                    </button>
                </div>
                <div class="tutor-input-meta">
                    <span asp-validation-for="Question" class="text-danger"></span>
                    <small id="tutor-input-help">Answers stay inside @course.Code and include source links.</small>
                    <small id="tutor-question-count" aria-live="polite">@(Model.Question?.Length ?? 0) / 800</small>
                </div>
            </form>
        </section>

        <aside class="tutor-tools" aria-label="Tutor prompts and course context">
            <section class="card tutor-quick-card">
                <div class="tutor-aside-head">
                    <span aria-hidden="true">✦</span>
                    <div><h2>Quick prompts</h2><p>Start with a learning goal.</p></div>
                </div>
                <div class="tutor-intent-grid">
                    <button type="button" class="tutor-intent" data-tutor-prompt="Explain @primaryTopic simply and step by step">
                        <span aria-hidden="true">◎</span><strong>Explain this simply</strong>
                    </button>
                    <button type="button" class="tutor-intent" data-tutor-prompt="Give me a worked example for @primaryTopic">
                        <span aria-hidden="true">↳</span><strong>Give me an example</strong>
                    </button>
                    <button type="button" class="tutor-intent" data-tutor-prompt="Create a 5-question quiz on @primaryTopic with an answer guide">
                        <span aria-hidden="true">✓</span><strong>Create a quiz</strong>
                    </button>
                    <button type="button" class="tutor-intent" data-tutor-prompt="Build a 7-day study plan for @primaryTopic in @course.Code">
                        <span aria-hidden="true">▦</span><strong>Build a study plan</strong>
                    </button>
                </div>
                @if (Model.Workspace.SuggestedQuestions.Count > 0)
                {
                    <h3>Suggested for @course.Code</h3>
                    <div class="tutor-suggestion-list">
                        @foreach (var prompt in Model.Workspace.SuggestedQuestions.Take(4))
                        {
                            <button type="button" data-tutor-prompt="@prompt">@prompt <span aria-hidden="true">→</span></button>
                        }
                    </div>
                }
            </section>

            <section class="card tutor-trust-card">
                <span class="tutor-trust-icon" aria-hidden="true">✓</span>
                <div>
                    <h2>Course-grounded by design</h2>
                    <p>Drafts, rejected uploads, unvalidated files, and resources from other courses are excluded before ranking.</p>
                </div>
            </section>

            @if (Model.Exchange?.FollowUpQuestions.Count > 0)
            {
                <section class="card tutor-followup-card">
                    <h2>Continue learning</h2>
                    @foreach (var prompt in Model.Exchange.FollowUpQuestions)
                    {
                        <button type="button" data-tutor-prompt="@prompt">@prompt</button>
                    }
                </section>
            }
        </aside>
    </div>
}

@section Styles {
    <style>
        .tutor-page-head{display:flex;align-items:center;justify-content:space-between;gap:1.25rem;margin-block-end:1.25rem}.tutor-title-lockup{display:flex;align-items:center;gap:1rem}.tutor-title-lockup h1{margin:.15rem 0 .3rem;font-size:clamp(2rem,4vw,3rem);letter-spacing:-.04em}.tutor-title-lockup p{max-width:48rem;margin:0;color:var(--ink-500);font-size:1.05rem}.tutor-title-icon{display:grid;flex:0 0 auto;width:3.5rem;height:3.5rem;place-items:center;border-radius:1.15rem;background:linear-gradient(145deg,var(--blue-600),#7048e8);box-shadow:0 14px 28px rgba(36,107,253,.22);color:#fff}.tutor-title-icon svg{width:1.75rem;fill:none;stroke:currentColor;stroke-width:1.8}.tutor-course-link{white-space:nowrap}.tutor-empty{max-width:44rem;margin:4rem auto;padding:3rem;text-align:center}.tutor-empty-icon{display:grid;width:4rem;height:4rem;margin:0 auto 1rem;place-items:center;border-radius:1.25rem;background:var(--blue-100);color:var(--blue-600);font-size:1.8rem}.tutor-empty h2{font-size:1.55rem}.tutor-empty p{color:var(--ink-500);font-size:1.05rem;line-height:1.7}.tutor-context-bar{display:flex;align-items:center;gap:.9rem;margin-block-end:1rem;padding:1rem 1.15rem;border:1px solid var(--line);border-radius:1rem;background:var(--surface);box-shadow:var(--shadow-sm)}.tutor-context-dot,.tutor-online-dot{width:.7rem;height:.7rem;border-radius:50%;background:#2f7df6;box-shadow:0 0 0 .3rem rgba(47,125,246,.14)}.tutor-context-copy{display:grid;gap:.08rem}.tutor-context-copy>span{color:var(--ink-500);font-size:.78rem;font-weight:750;text-transform:uppercase;letter-spacing:.06em}.tutor-context-copy strong{font-size:1.08rem}.tutor-context-copy small{color:var(--ink-500);font-size:.9rem}.tutor-context-bar>a{margin-inline-start:auto;font-weight:750;text-decoration:none}.tutor-context-reset{font-size:1rem}.tutor-layout{display:grid;grid-template-columns:minmax(0,1fr) 21rem;gap:1.25rem;align-items:start}.tutor-chat{overflow:hidden;padding:0}.tutor-chat-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.25rem;border-block-end:1px solid var(--line);background:linear-gradient(135deg,var(--surface),var(--blue-50))}.tutor-chat-head>div{display:grid;grid-template-columns:auto 1fr;align-items:center;column-gap:.65rem}.tutor-chat-head .tutor-online-dot{grid-row:1/3}.tutor-chat-head strong{font-size:1.05rem}.tutor-chat-head small{color:var(--ink-500);font-size:.86rem}.tutor-source-count{padding:.45rem .7rem;border-radius:999px;background:var(--blue-100);color:var(--blue-700);font-size:.82rem;font-weight:750}.tutor-messages{min-height:28rem;max-height:62vh;overflow-y:auto;padding:1.4rem;background:linear-gradient(180deg,var(--surface-soft),var(--surface))}.tutor-message{display:flex;align-items:flex-start;gap:.75rem;margin-block-end:1.25rem}.tutor-message-user{justify-content:flex-end;margin-inline-start:14%}.tutor-message-assistant{margin-inline-end:4%}.tutor-avatar{display:grid;flex:0 0 auto;width:2.4rem;height:2.4rem;place-items:center;border-radius:.8rem;background:linear-gradient(145deg,var(--blue-600),#7048e8);color:#fff;font-size:1rem;font-weight:800}.tutor-avatar-user{background:var(--navy-900);font-size:.7rem}.tutor-bubble{max-width:100%;padding:1rem 1.1rem;border:1px solid var(--line);border-radius:.35rem 1.15rem 1.15rem 1.15rem;background:var(--surface);box-shadow:var(--shadow-sm);font-size:1rem;line-height:1.7}.tutor-message-user .tutor-bubble{border:0;border-radius:1.15rem .35rem 1.15rem 1.15rem;background:var(--blue-600);color:#fff}.tutor-bubble>strong{display:block;margin-block-end:.3rem;font-size:1.04rem}.tutor-bubble>p{margin:0;color:var(--ink-700)}.tutor-message-user .tutor-bubble p{color:inherit}.tutor-answer{width:min(100%,53rem);padding:1.15rem 1.25rem}.tutor-answer-lead{font-size:1.05rem;font-weight:650}.tutor-answer-section{padding-block:1rem;border-block-start:1px solid var(--line)}.tutor-answer-section:first-of-type{margin-block-start:1rem}.tutor-answer-section h2,.tutor-citations h2{margin:0 0 .45rem;font-size:1rem;font-weight:800}.tutor-answer-section p{margin:0;white-space:pre-line;color:var(--ink-700);font-size:1rem;line-height:1.72}.tutor-scope-badge{display:inline-flex;margin-block-end:.8rem;padding:.35rem .6rem;border-radius:999px;background:var(--amber-100);color:#8a4b00;font-size:.78rem;font-weight:800;text-transform:uppercase;letter-spacing:.04em}.tutor-message-redirect .tutor-bubble{border-color:#f6d58b}.tutor-citations{padding-block-start:1rem;border-block-start:1px solid var(--line)}.tutor-source-list{display:grid;gap:.65rem}.tutor-source{display:grid;grid-template-columns:auto 1fr auto;gap:.75rem;align-items:start;padding:.8rem;border:1px solid var(--line);border-radius:.85rem;background:var(--surface-soft);color:var(--ink-900);text-decoration:none;transition:transform var(--ease),border-color var(--ease),box-shadow var(--ease)}.tutor-source:hover{transform:translateY(-1px);border-color:var(--blue-500);box-shadow:var(--shadow-sm);color:var(--ink-900)}.tutor-source-number{display:grid;width:1.7rem;height:1.7rem;place-items:center;border-radius:.5rem;background:var(--blue-600);color:#fff;font-size:.78rem;font-weight:800}.tutor-source>span:nth-child(2){display:grid;gap:.15rem}.tutor-source strong{font-size:.94rem}.tutor-source small{color:var(--blue-600);font-size:.78rem;font-weight:700}.tutor-source>span:nth-child(2)>span{color:var(--ink-500);font-size:.86rem;line-height:1.45}.tutor-source-arrow{color:var(--blue-600);font-size:1.15rem}.tutor-composer{padding:1rem 1.25rem 1.1rem;border-block-start:1px solid var(--line);background:var(--surface)}.tutor-composer>label{display:block;margin-block-end:.45rem;font-size:.9rem;font-weight:800}.tutor-input-wrap{display:flex;align-items:flex-end;gap:.65rem;padding:.55rem;border:1px solid var(--line-strong);border-radius:1rem;background:var(--input-bg);transition:border-color var(--ease),box-shadow var(--ease)}.tutor-input-wrap:focus-within{border-color:var(--blue-500);box-shadow:0 0 0 .22rem rgba(36,107,253,.12)}.tutor-input-wrap textarea{flex:1;min-height:4.5rem;max-height:12rem;padding:.45rem .55rem;border:0;outline:0;resize:vertical;background:transparent;color:var(--ink-900);font:inherit;font-size:1rem;line-height:1.55}.tutor-input-wrap textarea::placeholder{color:var(--ink-400)}.tutor-send{display:flex;align-items:center;gap:.45rem;min-height:2.75rem;padding-inline:1rem}.tutor-send svg{width:1rem;fill:none;stroke:currentColor;stroke-width:1.8}.tutor-input-meta{display:flex;align-items:center;gap:.75rem;margin-block-start:.45rem;color:var(--ink-500)}.tutor-input-meta small{font-size:.8rem}.tutor-input-meta small:last-child{margin-inline-start:auto}.tutor-tools{display:grid;gap:1rem}.tutor-tools>.card{padding:1.15rem}.tutor-aside-head{display:flex;align-items:center;gap:.7rem;margin-block-end:1rem}.tutor-aside-head>span{display:grid;width:2.25rem;height:2.25rem;place-items:center;border-radius:.7rem;background:var(--blue-100);color:var(--blue-600)}.tutor-aside-head h2,.tutor-trust-card h2,.tutor-followup-card h2{margin:0;font-size:1.02rem}.tutor-aside-head p{margin:0;color:var(--ink-500);font-size:.86rem}.tutor-intent-grid{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}.tutor-intent{display:grid;gap:.4rem;min-height:6.2rem;padding:.75rem;border:1px solid var(--line);border-radius:.85rem;background:var(--surface-soft);color:var(--ink-700);text-align:start;transition:border-color var(--ease),background var(--ease),transform var(--ease)}.tutor-intent:hover{transform:translateY(-1px);border-color:var(--blue-500);background:var(--blue-50);color:var(--blue-700)}.tutor-intent>span{font-size:1.2rem;color:var(--blue-600)}.tutor-intent strong{font-size:.87rem;line-height:1.3}.tutor-quick-card>h3{margin:1.15rem 0 .55rem;font-size:.88rem}.tutor-suggestion-list{display:grid;gap:.35rem}.tutor-suggestion-list button,.tutor-followup-card button{display:flex;width:100%;justify-content:space-between;gap:.5rem;padding:.6rem .2rem;border:0;border-block-start:1px solid var(--line);background:transparent;color:var(--ink-700);font-size:.88rem;text-align:start}.tutor-suggestion-list button:hover,.tutor-followup-card button:hover{color:var(--blue-600)}.tutor-trust-card{display:flex;gap:.75rem;border-color:#a7e8d3;background:linear-gradient(145deg,var(--surface),var(--green-100))}.tutor-trust-icon{display:grid;flex:0 0 auto;width:2rem;height:2rem;place-items:center;border-radius:50%;background:var(--green-700);color:#fff;font-weight:800}.tutor-trust-card p{margin:.35rem 0 0;color:var(--ink-700);font-size:.88rem;line-height:1.55}.tutor-followup-card{display:grid;gap:.25rem}.tutor-followup-card h2{margin-block-end:.35rem}@@media(max-width:1050px){.tutor-layout{grid-template-columns:1fr}.tutor-tools{grid-template-columns:1fr 1fr}.tutor-quick-card{grid-row:span 2}}@@media(max-width:700px){.tutor-page-head{align-items:flex-start;flex-direction:column}.tutor-title-icon{width:3rem;height:3rem}.tutor-course-link{width:100%}.tutor-context-bar{align-items:flex-start;flex-wrap:wrap}.tutor-context-bar>a{width:100%;margin-inline-start:1.6rem}.tutor-layout{gap:.8rem}.tutor-tools{grid-template-columns:1fr}.tutor-quick-card{grid-row:auto}.tutor-chat-head{align-items:flex-start;flex-direction:column}.tutor-messages{min-height:22rem;padding:1rem}.tutor-message-user{margin-inline-start:5%}.tutor-message-assistant{margin-inline-end:0}.tutor-avatar{width:2rem;height:2rem}.tutor-bubble{padding:.85rem}.tutor-composer{padding:.85rem}.tutor-input-wrap{align-items:stretch;flex-direction:column}.tutor-send{justify-content:center}.tutor-input-meta{align-items:flex-start;flex-wrap:wrap}.tutor-input-meta small:last-child{margin-inline-start:auto}}html[dir="rtl"] .tutor-source-arrow{transform:scaleX(-1)}
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const input = document.getElementById('Question');
            const count = document.getElementById('tutor-question-count');
            if (!input) return;
            const updateCount = () => {
                if (count) count.textContent = `${input.value.length} / 800`;
            };
            document.querySelectorAll('[data-tutor-prompt]').forEach(button => {
                button.addEventListener('click', () => {
                    input.value = button.dataset.tutorPrompt || '';
                    updateCount();
                    input.focus();
                    input.setSelectionRange(input.value.length, input.value.length);
                    input.scrollIntoView({ behavior: 'smooth', block: 'center' });
                });
            });
            input.addEventListener('input', updateCount);
            updateCount();
            @if (Model.Exchange is not null)
            {
                <text>document.querySelector('.tutor-messages')?.scrollTo({ top: document.querySelector('.tutor-messages').scrollHeight, behavior: 'smooth' });</text>
            }
        })();
    </script>
}
