@model Masdar.Web.ViewModels.ResourceCardViewModel
<article class="card resource-card p-3 h-100">
    <div class="d-flex justify-content-between gap-2 align-items-start">
        <span class="badge badge-blue">@Model.Type</span>
        @if (Model.IsVerified) { <span class="badge badge-green">Verified</span> }
    </div>
    <h3 class="h6 mt-3 mb-1"><a asp-controller="Resources" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></h3>
    <p class="small text-muted">@Model.CourseCode · @Model.Semester</p>
    <p class="small flex-grow-1">@Model.Description</p>
    @if (Model.Tags.Count > 0)
    {
        <div class="d-flex flex-wrap gap-1 mb-3" aria-label="Tags">
            @foreach (var tag in Model.Tags.Take(4)) { <span class="badge badge-gray">#@tag</span> }
        </div>
    }
    <div class="d-flex justify-content-between align-items-center small">
        <span aria-label="Average rating @Model.AverageRating out of 5">★ @Model.AverageRating.ToString("0.0") (@Model.RatingCount)</span>
        <span>@Model.HelpfulCount helpful</span>
    </div>
    <a class="btn btn-secondary mt-3" asp-controller="Resources" asp-action="Details" asp-route-id="@Model.Id">View resource</a>
</article>
