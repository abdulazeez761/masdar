@model CourseInputModel
@{ ViewData["Title"] = Model.Id == 0 ? "Add course" : "Edit course"; }
<partial name="_AdminNav" />
<header class="page-head"><div><span class="eyebrow">Academic catalog</span><h1>@ViewData["Title"]</h1><p>Course metadata powers discovery, roadmaps, and tutor context.</p></div></header>
<form method="post" class="card edit-form"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field full"><label asp-for="MajorId"></label><select asp-for="MajorId" asp-items="Model.MajorOptions"><option value="">Select a major</option></select><span asp-validation-for="MajorId"></span></div><div class="field"><label asp-for="Code"></label><input asp-for="Code" /><span asp-validation-for="Code"></span></div><div class="field"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Instructor"></label><input asp-for="Instructor" /><span asp-validation-for="Instructor"></span></div><div class="field"><label asp-for="Semester"></label><input asp-for="Semester" /><span asp-validation-for="Semester"></span></div><div class="field"><label asp-for="ExamDateUtc"></label><input asp-for="ExamDateUtc" /><span asp-validation-for="ExamDateUtc"></span></div><div class="field full"><label asp-for="Description"></label><textarea asp-for="Description" rows="5"></textarea><span asp-validation-for="Description"></span></div><label class="check-row"><input asp-for="IsActive" /> Active</label></div><div class="form-actions"><a class="btn btn-secondary" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Save course</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
