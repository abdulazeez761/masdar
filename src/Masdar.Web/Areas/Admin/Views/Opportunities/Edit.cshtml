@model OpportunityInputModel
@{ ViewData["Title"] = Model.Id == 0 ? "Add opportunity" : "Edit opportunity"; }
<partial name="_AdminNav" />
<header class="page-head"><div><span class="eyebrow">Beyond the classroom</span><h1>@ViewData["Title"]</h1><p>Publish a clear, actionable opportunity for students.</p></div></header>
<form method="post" class="card edit-form"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="form-grid"><div class="field"><label asp-for="Type"></label><select asp-for="Type" asp-items="Html.GetEnumSelectList<OpportunityType>()"></select></div><div class="field"><label asp-for="Title"></label><input asp-for="Title" /><span asp-validation-for="Title"></span></div><div class="field full"><label asp-for="Description"></label><textarea asp-for="Description" rows="5"></textarea><span asp-validation-for="Description"></span></div><div class="field"><label asp-for="Location"></label><input asp-for="Location" /></div><div class="field"><label asp-for="RegistrationUrl"></label><input asp-for="RegistrationUrl" /></div><div class="field"><label asp-for="StartsAtUtc"></label><input asp-for="StartsAtUtc" type="datetime-local" /></div><div class="field"><label asp-for="EndsAtUtc"></label><input asp-for="EndsAtUtc" type="datetime-local" /></div><div class="field"><label asp-for="RegistrationDeadlineUtc"></label><input asp-for="RegistrationDeadlineUtc" type="datetime-local" /></div><div class="field"><label asp-for="Capacity"></label><input asp-for="Capacity" /></div><label class="check-row"><input asp-for="IsPublished" /> Published</label><label class="check-row"><input asp-for="IsActive" /> Active</label></div><div class="form-actions"><a class="btn btn-secondary" asp-action="Index">Cancel</a><button class="btn btn-primary" type="submit">Save opportunity</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
