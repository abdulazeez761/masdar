@model StudyResource
@{ ViewData["Title"] = "Moderate resource"; var moderation = (ResourceModerationInputModel)ViewBag.Moderation; var rating = Model.Ratings.Count == 0 ? 0 : Model.Ratings.Average(x => x.Value); }
<partial name="_AdminNav" />
<header class="page-head"><div><span class="eyebrow">Resource moderation</span><h1>@Model.Title</h1><p>@Model.Course.Code · shared by @Model.Uploader.DisplayName</p></div><a class="btn btn-secondary" asp-action="Index">Back to resources</a></header>
<div class="admin-grid">
    <section class="card admin-panel"><div class="resource-card-top"><span class="badge badge-blue">@Model.Type</span><span class="badge @(Model.VerificationStatus == ResourceVerificationStatus.Verified ? "badge-green" : "badge-gray")">@Model.VerificationStatus</span></div><p>@Model.Description</p><dl class="detail-list"><div><dt>University</dt><dd>@Model.Course.Major.University.Name</dd></div><div><dt>Course</dt><dd>@Model.Course.Code · @Model.Course.Name</dd></div><div><dt>File</dt><dd>@Model.OriginalFileName</dd></div><div><dt>Size</dt><dd>@((Model.FileSizeBytes / 1024d).ToString("N0")) KB</dd></div><div><dt>Scan</dt><dd>@Model.FileScanStatus</dd></div><div><dt>Rating</dt><dd>@rating.ToString("0.0") from @Model.Ratings.Count</dd></div><div><dt>Helpful</dt><dd>@Model.HelpfulVotes.Count</dd></div><div><dt>Tags</dt><dd>@string.Join(", ", Model.ResourceTags.Select(x => x.Tag.Name))</dd></div></dl></section>
    <section class="card admin-panel"><h2>Moderation decision</h2><form asp-action="Moderate" asp-route-id="@Model.Id" method="post"><input type="hidden" name="Id" value="@Model.Id" /><div class="field"><label for="PublicationStatus">Publication status</label><select id="PublicationStatus" name="PublicationStatus" asp-items="Html.GetEnumSelectList<ResourcePublicationStatus>()"></select></div><div class="field"><label for="VerificationStatus">Verification status</label><select id="VerificationStatus" name="VerificationStatus" asp-items="Html.GetEnumSelectList<ResourceVerificationStatus>()"></select></div><label class="check-row"><input type="checkbox" name="IsRepresentative" value="true" checked="@moderation.IsRepresentative" /> Representative of this course</label><div class="field"><label for="Note">Internal audit note</label><textarea id="Note" name="Note" rows="4"></textarea></div><button class="btn btn-primary" type="submit">Save decision</button></form><form asp-action="Archive" asp-route-id="@Model.Id" method="post" class="danger-zone"><button class="btn btn-danger" type="submit">Archive resource</button></form></section>
</div>
<script>document.getElementById('PublicationStatus').value='@moderation.PublicationStatus';document.getElementById('VerificationStatus').value='@moderation.VerificationStatus';</script>
