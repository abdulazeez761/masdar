{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads",
    "MaximumBytes": 10485760,
    "AllowedExtensions": [ ".pdf", ".docx" ]
  },
  "SeedData": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrations": false
  },
  "Rag": {
    "Provider": "Gemini",
    "ApiKey": "",
    "ChatModel": "gemini-3.6-flash",
    "EmbeddingModel": "gemini-embedding-001",
    "EmbeddingDimensions": 768,
    "TopK": 6,
    "MinimumSimilarity": 0.25,
    "ChunkSize": 1200,
    "ChunkOverlap": 180,
    "MaximumCharactersPerResource": 100000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
